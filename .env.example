# Copy to .env for local overrides. All values are optional.

# "development" or "production". Production disables the OpenAPI docs.
ENVIRONMENT=development

# Host allowlist for TrustedHostMiddleware, as a JSON list.
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Directory with the Markdown and YAML content files.
# Defaults to the content/ directory in the repository.
# CONTENT_DIR=content

# Public URL of the site, used for absolute links in the Atom feed.
SITE_URL=http://localhost:8000

# Repository metadata (latest release, last push) is fetched from GitHub
# in the background. The token is optional; without it GitHub allows 60
# requests per hour, which is plenty for a few projects.
GITHUB_ENABLED=true
# GITHUB_TOKEN=
GITHUB_REFRESH_SECONDS=3600
GITHUB_TIMEOUT_SECONDS=10
