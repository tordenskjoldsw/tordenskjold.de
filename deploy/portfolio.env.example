# Production settings, installed as /etc/portfolio/portfolio.env (mode 0600,
# owned by root; systemd reads it before dropping privileges).
#
# systemd strips double quotes in environment files, so JSON values must be
# wrapped in single quotes.

ENVIRONMENT=production
ALLOWED_HOSTS='["tordenskjold.de"]'
SITE_URL=https://tordenskjold.de
LEGAL_DIR=/etc/portfolio/legal

# Optional. Without a token GitHub allows 60 requests per hour, which is
# plenty for a few projects.
# GITHUB_TOKEN=
